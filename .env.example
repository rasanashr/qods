# ============================
# متغیرهای محیطی شبکه قدس
# ============================
# این فایل را در Vercel به‌عنوان Environment Variables تنظیم کنید

# پایگاه داده (SQLite برای توسعه محلی؛ برای Vercel از PostgreSQL استفاده کنید)
# مثال PostgreSQL: postgresql://user:pass@host:port/dbname?schema=public
DATABASE_URL="file:./db/custom.db"

# JWT secret ادمین — حداقل ۳۲ کاراکتر، رشته تصادفی
ADMIN_JWT_SECRET="quds-admin-secret-change-in-production-very-long-string-32chars-min"

# JWT secret کاربر — حداقل ۳۲ کاراکتر
USER_JWT_SECRET="quds-user-secret-change-in-production-very-long-string-32chars-min"

# (اختیاری) فعال‌سازی حالت sandbox برای OTP — کد به‌جای SMS در response برمی‌گردد
OTP_SANDBOX="true"
